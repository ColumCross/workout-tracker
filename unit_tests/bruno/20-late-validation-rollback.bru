meta {
  name: 20 - Late validation rollback
  type: http
  seq: 20
}

post {
  url: {{base_url}}/rest/v1/rpc/saveWorkout
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  {
    "payload": {
      "workoutID": "{{rollback_workout_id}}",
      "local_timezone": "Etc/UTC",
      "exercises": [
        { "exercise_name": "Rollback valid first", "sets": [{ "reps": 6, "weight_g": 1000, "set_number": 1 }] },
        { "exercise_name": "Rollback invalid late", "sets": [{ "reps": 0, "weight_g": 1000, "set_number": 2 }] }
      ]
    }
  }
}

tests {
  test("Late set failure is the intended constraint", () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("23514");
  });
}
