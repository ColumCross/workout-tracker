meta {
  name: 77 - Refreshed B session works
  type: http
  seq: 77
}

get {
  url: {{base_url}}/functions/v1/getWorkoutID
  body: none
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_b}}
}

tests {
  test("Refreshed B token remains owner-scoped", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().workoutID).to.match(new RegExp("-" + bru.getEnvVar("user_b_id") + "$"));
  });
}
