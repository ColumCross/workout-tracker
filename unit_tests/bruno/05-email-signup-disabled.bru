meta {
  name: 05 - Email signup disabled
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/v1/signup
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Content-Type: application/json
}

body:json {
  { "email": "{{signup_email}}", "password": "{{signup_password}}" }
}

tests {
  test("Email signup is specifically disabled", () => {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().error_code).to.equal("signup_disabled");
  });
}
