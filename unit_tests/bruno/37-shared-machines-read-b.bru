meta {
  name: 37 - B reads same shared machine
  type: http
  seq: 37
}

get {
  url: {{base_url}}/rest/v1/machines?select=ID&ID=eq.{{shared_machine_id}}
  body: none
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_b}}
}

tests {
  test("B sees the same shared machine", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ ID: bru.getEnvVar("shared_machine_id") }]);
  });
}
