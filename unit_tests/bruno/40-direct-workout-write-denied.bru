meta {
  name: 40 - Direct workout write denied
  type: http
  seq: 40
}

post {
  url: {{base_url}}/rest/v1/workouts
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  { "workoutID": "direct-write-probe", "user": "{{user_a_id}}", "start_time": "2026-01-01T00:00:00Z", "end_time": "2026-01-01T00:01:00Z", "local_timezone": "Etc/UTC" }
}

tests {
  test("Authenticated has no direct workout INSERT", () => {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}
