meta {
  name: 42 - Direct set write denied
  type: http
  seq: 42
}

post {
  url: {{base_url}}/rest/v1/sets
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  { "user": "{{user_a_id}}", "workoutID": "{{workout_id_a}}", "exerciseID": "{{exercise_id_a}}", "reps": 1, "weight_g": 0, "set_number": 99 }
}

tests {
  test("Authenticated has no direct set INSERT", () => {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().code).to.equal("42501");
  });
}
