meta {
  name: 15 - Changed retry A is idempotent
  type: http
  seq: 15
}

post {
  url: {{base_url}}/rest/v1/rpc/saveWorkout
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  { "payload": { "workoutID": "{{workout_id_a}}", "local_timezone": "MUST NOT CHANGE", "exercises": [{ "exercise_name": "MUST NOT OVERWRITE", "sets": [{ "reps": 1, "weight_g": 1, "set_number": 99 }] }] } }
}

tests {
  test("First successful save wins", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, workoutID: bru.getEnvVar("workout_id_a") }]);
  });
}
