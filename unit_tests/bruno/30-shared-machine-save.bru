meta {
  name: 30 - Shared machine succeeds
  type: http
  seq: 30
}

post {
  url: {{base_url}}/rest/v1/rpc/saveWorkout
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  { "payload": { "workoutID": "{{validation_workout_id}}", "local_timezone": "Etc/UTC", "exercises": [{ "exercise_name": "A shared machine retry", "machine_id": "{{shared_machine_id}}", "sets": [{ "reps": 2, "weight_g": 1000, "set_number": 1 }] }] } }
}

tests {
  test("Corrected shared-machine payload succeeds with same ID", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal([{ success: true, workoutID: bru.getEnvVar("validation_workout_id") }]);
  });
}
