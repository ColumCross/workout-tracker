meta {
  name: 31 - A history after validation
  type: http
  seq: 31
}

get {
  url: {{base_url}}/functions/v1/getWorkouts?userId={{user_a_id}}
  body: none
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("Only successful A aggregates are present and ordered", () => {
    expect(res.getStatus()).to.equal(200);
    const workouts = res.getBody().workouts;
    expect(workouts).to.have.length(3);
    for (let i = 1; i < workouts.length; i += 1) {
      expect(Date.parse(workouts[i - 1].start_time)).to.be.at.most(Date.parse(workouts[i].start_time));
    }
    expect(workouts[2].exercises[0].exercise_name).to.equal("A shared machine retry");
  });
}
