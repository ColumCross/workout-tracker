meta {
  name: 32 - A can read own profile
  type: http
  seq: 32
}

get {
  url: {{base_url}}/rest/v1/users?select=user,name,weight_g,height_cm,eula_acknowledged
  body: none
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("RLS exposes exactly A's profile", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.length(1);
    expect(res.getBody()[0].user).to.equal(bru.getEnvVar("user_a_id"));
  });
}
