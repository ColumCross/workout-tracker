meta {
  name: 53 - Initial EULA status A
  type: http
  seq: 53
}

get {
  url: {{base_url}}/functions/v1/getUserEULAStatus
  body: none
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
}

tests {
  test("Fresh A has not acknowledged", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("cache-control")).to.equal("no-store");
    expect(res.getBody()).to.deep.equal({ eulaAcknowledged: false });
  });
}
