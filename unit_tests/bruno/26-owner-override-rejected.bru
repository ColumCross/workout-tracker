meta {
  name: 26 - Caller cannot override owner
  type: http
  seq: 26
}

post {
  url: {{base_url}}/rest/v1/rpc/saveWorkout
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token_a}}
  Content-Type: application/json
}

body:json {
  { "payload": { "workoutID": "{{validation_workout_id}}", "user": "{{user_b_id}}", "local_timezone": "Etc/UTC", "exercises": [{ "exercise_name": "Owner override", "sets": [{ "reps": 1, "weight_g": 0, "set_number": 1 }] }] } }
}

tests {
  test("Unsupported owner field is rejected", () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("22023");
  });
}
